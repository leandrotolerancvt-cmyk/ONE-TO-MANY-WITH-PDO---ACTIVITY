<?php
require "config/database.php";

// UPDATE rental
if (isset($_POST['update'])) {
    $stmt = $pdo->prepare("UPDATE rentals SET car_model=?, plate_no=?, rental_date=?, return_date=?, total_price=? WHERE rental_id=?");
    $stmt->execute([$_POST['car_model'], $_POST['plate_no'], $_POST['rental_date'], $_POST['return_date'], $_POST['total_price'], $_POST['rental_id']]);
    header("Location: rentals.php?customer_id=" . $_POST['customer_id']); exit;
}
$stmt = $pdo->prepare("SELECT * FROM rentals WHERE rental_id = ?");
$stmt->execute([$_GET['id']]);
$r = $stmt->fetch(PDO::FETCH_ASSOC);
if (!$r) die("Rental not found.");
?>
